rules_version = '2';

// כללי האבטחה של מסד הנתונים (סידור עבודה + הצעות מחיר + הרשאות).
// מתפרסם אוטומטית מ-GitHub (Actions ← Publish security rules).
// מדביקים את כל הקובץ ב-Firebase Console ← Firestore Database ← Rules ← Publish.
// בעל הרשת נקבע ב-orgcfg/main.ownerEmail (בעל המערכת קובע אותו); בלי זה — בעל המערכת.
//
// מי רואה מה:
//  - בעל המערכת: הכל.
//  - לכל אדם אחר יש מסמך הרשאות (roles) עם רשימת מלונות ואפליקציות:
//      shifts = ניהול סידור עבודה במלונות שלו (בלי מלונות = כולם)
//      events = הצעות מחיר לאירועים
//      perms  = ניהול הרשאות: נותן לאחרים רק אפליקציות ומלונות שיש לו בעצמו
//      ceo    = מבט מנכ״ל: הכנסות ועלויות עובדים, קריאה בלבד
//      dept   = מנהל מחלקה: מסדר רק את המחלקות שלו (depts), בלי שכר
//      gm     = מנהל מלון: כל נתוני המלונות שלו (hotels), אישור דרישות רכש
//      brief  = בריף יומי: 10days, האירועים ומי במשמרת
//      maint  = אחזקה: תקלות של המלונות שלו
//      fin    = כספים: מאשר שהמזומן שהופקד בכל דוח סוף משמרת הוא הסכום שנכתב
//      front  = קבלת המלון: סידור העבודה והאירועים של המלון, הזנת 10days.
//               station = true: משתמש עמדת קבלה משותף (שם משתמש וסיסמה), לא אדם
//      mkt    = שיווק: קמפיינים
//      exp    = הוצאות: ספקים, חשבוניות ומחירים, לפי המלונות ב-expHotels (ריק = כולם). מבט מנכ״ל קורא את החשבוניות
//  - עובד בלי הרשאות: הפרטים, הזמינות והמשמרות שלו והצוות של המלון שלו בלבד. אף פעם לא שכר ולא מלון אחר.
//  - עובד רשת (hotel = 'chain'): הנהלה ומשרד. נרשם עם קוד הרשת, לא נספר בנוכחות ולא משתבץ במשמרות.
//  - מי שלא מחובר: כלום.

service cloud.firestore {
  match /databases/{database}/documents {

    // the chain owner's e-mail is kept in orgcfg/main.ownerEmail (set by the system owner), so the same rules work in every chain's database
    // the chain owner's e-mail (orgcfg/main.ownerEmail). One get() only: the old exists()+get() pair, evaluated inside every
    // isOwner() call, pushed some writes over Firestore's 1000-expression limit (Oct 24). orgcfg/main always exists in a set-up project.
    function ownerEmail() {
      return get(/databases/$(database)/documents/orgcfg/main).data.get('ownerEmail', 'kfirdaabul1@gmail.com');
    }
    function platformEmail() { return 'kfirdaabul1@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function isPlatform() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == platformEmail();
    }
    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        // Nov 8 (owner): the system owner is an owner only where he is the chain's owner (Seven, his demo hotel). In other chains / hotels
        // he keeps only the platform rights (isPlatform: orgcfg, registry) and sees no data, financial or other, unless they give him a role.
        && request.auth.token.email.lower() == ownerEmail();
    }

    // ---------- הרשאות ----------
    function hasRole() {
      return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }
    function roleData() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }
    function roleHotels() { return roleData().get('hotels', []); }
    // מסמך הרשאות ישן בלי apps נחשב כמנהל סידור
    function roleApp(a) { return roleData().get('apps', {'shifts': true}).get(a, false) == true; }

    function canShifts() { return isOwner() || (hasRole() && roleApp('shifts')); }
    function canEvents() { return isOwner() || (hasRole() && roleApp('events')); }
    function canPerms()  { return isOwner() || (hasRole() && roleApp('perms')); }
    function canCeo()    { return isOwner() || (hasRole() && roleApp('ceo')); }
    function canMkt()    { return isOwner() || (hasRole() && roleApp('mkt')); }
    function canExp()    { return isOwner() || (hasRole() && roleApp('exp')); }
    // הוצאות לפי מלון: expHotels במסמך ההרשאות (ריק = כל המלונות)
    function expHotelsR() { return roleData().get('expHotels', []); }
    function expAll() { return isOwner() || (canExp() && expHotelsR().size() == 0); }
    function expIn(h) { return expAll() || (canExp() && h in expHotelsR()); }
    // מי שנותן הוצאות נותן רק מלונות שיש לו בעצמו
    function expGrantOk(n) {
      return n.get('expHotels', []) is list && (!n.apps.get('exp', false) || isOwner() || expAll()
        || (n.get('expHotels', []).size() > 0 && n.get('expHotels', []).hasOnly(expHotelsR())));
    }
    function isManager() { return isOwner() || hasRole(); }

    // היקף המלונות של מי שמחזיק הרשאות (ריק = כל המלונות)
    function allHotels() { return isOwner() || (hasRole() && roleHotels().size() == 0); }
    // ניהול סידור במלון מסוים
    // עמוד עובדים: רק מי שיש לו הרשאת עובדים מקים, עורך ומוחק עובדים ושכר (במלונות שבהרשאה)
    // chain staff (hotel 'chain') are managed by anyone with the employees app (owner, Oct 23)
    function hrIn(h) { return isOwner() || (hasRole() && roleApp('hr') && (roleHotels().size() == 0 || h in roleHotels() || h == 'chain')); }
    function manages(h) { return isOwner() || (canShifts() && (roleHotels().size() == 0 || h in roleHotels())); }
    function shiftsAllHotels() { return isOwner() || (canShifts() && roleHotels().size() == 0); }
    // מנהל מחלקה: מסדר רק את המחלקות שלו במלונות שלו, בלי שכר
    function roleDepts() { return roleData().get('depts', []); }
    function deptMgr(h) { return hasRole() && roleApp('dept') && h in roleHotels(); }
    function deptManages(h, d) { return manages(h) || (deptMgr(h) && d in roleDepts()); }
    function hotelStaff(h) { return manages(h) || deptMgr(h); }
    // עובדי רשת (hotel = 'chain') עובדים בכל המלונות: כל מנהל סידור או מנהל מחלקה רואה את הזמינות שלהם
    function shiftsRole() { return canShifts() || (hasRole() && roleApp('dept')); }
    // מנהל מלון: רואה את כל נתוני המלונות שלו (roleHotels, ריק = כולם) ומאשר דרישות רכש
    function gmRole() { return hasRole() && roleApp('gm'); }
    // בריף יומי: רואה את האירועים (קריאה בלבד)
    // עמוד תלונות אורחים: רואה ומסמן טיפול בתלונות של המלונות שבהרשאה
    function cmpIn(h) { return isOwner() || (hasRole() && roleApp('cmp') && (roleHotels().size() == 0 || h in roleHotels())); }
    // שוברים: מנפיקים, רואים ומממשים. עמוד השובר לאורח קורא שובר אחד לפי המזהה הסודי שלו (get בלבד, בלי רשימה)
    function canVch() { return isOwner() || (hasRole() && roleApp('vch')); }
    function canVchR() { return isOwner() || (hasRole() && roleApp('vchr')); }
    function canSpa() { return isOwner() || (hasRole() && roleApp('spa')); }
    function canGrp() { return isOwner() || (hasRole() && roleApp('grp')); }
    function briefRole() { return hasRole() && roleApp('brief'); }
    // daily brief of a hotel: yesterday's reports (no money), open faults, housekeeping refresh/DND, guest complaints
    function briefIn(h) { return hasRole() && roleApp('brief') && (roleHotels().size() == 0 || h in roleHotels()); }
    // קבלת המלון: רואה סידור ואירועים של המלונות שלו ומזין 10days
    function frontIn(h) { return hasRole() && roleApp('front') && (roleHotels().size() == 0 || h in roleHotels()); }
    function gmIn(h) { return isOwner() || (gmRole() && (roleHotels().size() == 0 || h in roleHotels())); }
    // מי שרואה את נתוני המלון (עובדים, סידור, הגדרות): בעל המערכת, או הרשאה שקשורה למלון,
    // רק במלונות שבהרשאה (בלי מלונות = כל המלונות)
    function seesHotel(h) {
      return isOwner() || (h == 'chain' && hasRole() && roleApp('hr')) || (hasRole() && (roleHotels().size() == 0 || h in roleHotels())
        && (roleApp('shifts') || roleApp('dept') || roleApp('gm') || roleApp('brief') || roleApp('front') || roleApp('perms') || roleApp('hr')));
    }
    // אירועים לפי המקומות של המלון (settings.venues; מלון בלי מקומות לא רואה אירועים), עד 4 מלונות בהרשאה
    function venuesOf(h) { return get(/databases/$(database)/documents/settings/$(h)).data.get('venues', []); }
    function venueIn(h, v) { return v in venuesOf(h); }
    function hotelVenueOk(v) {
      let hs = roleHotels();
      return hs.size() == 0 || venueIn(hs[0], v)
        || (hs.size() > 1 && venueIn(hs[1], v)) || (hs.size() > 2 && venueIn(hs[2], v)) || (hs.size() > 3 && venueIn(hs[3], v));
    }
    // אחזקה: מנהל סידור, מנהל מלון, מנהל מחלקת אחזקה, או הרשאת אחזקה למלונות שלו
    function maintIn(h) {
      return manages(h) || gmIn(h) || (deptMgr(h) && 'maintenance' in roleDepts())
        || (hasRole() && roleApp('maint') && (roleHotels().size() == 0 || h in roleHotels()));
    }
    // כספים: מאשר את הפקדות המזומן של דוחות סוף משמרת במלונות שלו
    function finIn(h) { return isOwner() || (hasRole() && roleApp('fin') && (roleHotels().size() == 0 || h in roleHotels())); }
    // מלאי: מנהל סידור או מנהל מלון של המלון, או מנהל המחלקה
    function stockIn(h, d) { return manages(h) || gmIn(h) || (deptMgr(h) && d in roleDepts()); }

    // ---------- עובדים ----------
    function isEmployee() {
      return signedIn() && exists(/databases/$(database)/documents/employees/$(request.auth.uid));
    }
    function myHotel() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('hotel', 'main');
    }
    function isMember() { return isManager() || isEmployee(); }

    function hotelOf(d) { return d.get('hotel', 'main'); }
    // מזהה סידור: "2026-10-18" למלון הראשי, "2026-10-18_hxxxx" למלון אחר
    function schedHotel(id) { return id.split('_').size() > 1 ? id.split('_')[1] : 'main'; }

    // ---------- מתן הרשאות ----------
    // מסמך הרשאות בתוך ההיקף שלי: מלונות שאני מנהל (או שאני מנהל את כולם)
    function hotelsInScope(r) {
      return allHotels() || (r.get('hotels', []).size() > 0 && r.get('hotels', []).hasOnly(roleHotels()));
    }
    // האפליקציות במסמך הן רק כאלה שיש לי
    function appsWithin(a) {
      return (!a.get('shifts', false) || roleApp('shifts'))
        && (!a.get('events', false) || roleApp('events'))
        && (!a.get('perms', false) || roleApp('perms'))
        && (!a.get('ceo', false) || roleApp('ceo'))
        && (!a.get('dept', false) || roleApp('dept') || roleApp('shifts'))
        && (!a.get('mkt', false) || roleApp('mkt'))
        && (!a.get('exp', false) || roleApp('exp'))
        && (!a.get('gm', false) || roleApp('gm'))
        && (!a.get('brief', false) || roleApp('brief') || roleApp('gm'))
        && (!a.get('front', false) || roleApp('front'))
        && (!a.get('maint', false) || roleApp('maint') || roleApp('gm') || roleApp('shifts'))
        && (!a.get('fin', false) || roleApp('fin'))
        && (!a.get('hk', false) || roleApp('hk') || roleApp('gm') || roleApp('shifts'))
        && (!a.get('hr', false) || roleApp('hr'))
        && (!a.get('spa', false) || roleApp('spa'))
        && (!a.get('grp', false) || roleApp('grp'))
        && (!a.get('cmp', false) || roleApp('cmp'))
        && (!a.get('vch', false) || roleApp('vch'))
        && (!a.get('vchr', false) || roleApp('vchr'))
        && (!a.get('hkchk', false) || roleApp('hkchk') || roleApp('gm') || roleApp('shifts'))
        && (!a.get('rates', false) || roleApp('rates') || roleApp('gm') || roleApp('ceo'));
    }
    function grantOk(n) {
      return n.apps is map
        && n.apps.keys().hasOnly(['shifts', 'events', 'perms', 'ceo', 'dept', 'mkt', 'exp', 'gm', 'brief', 'front', 'maint', 'fin', 'hk', 'hr', 'spa', 'grp', 'cmp', 'vch', 'vchr', 'hkchk', 'rates'])
        && n.get('hotels', []) is list
        && n.get('depts', []) is list
        && (isOwner() || roleApp('shifts') || n.get('depts', []).hasOnly(roleDepts()))
        && appsWithin(n.apps)
        && expGrantOk(n)
        && hotelsInScope(n);
    }
    // משתמש עמדת קבלה (לא אדם): רק קבלה, במלון אחד
    function stationOk(r) {
      return r.get('station', false) == true && r.get('apps', {}).keys().hasOnly(['front']) && r.get('hotels', []).size() == 1;
    }
    function existingOk(r) { return appsWithin(r.get('apps', {'shifts': true})) && hotelsInScope(r); }
    // the employees app may set roles of chain staff (all hotels), only with apps the granter holds
    function chainTarget(uid) { return exists(/databases/$(database)/documents/employees/$(uid)) && get(/databases/$(database)/documents/employees/$(uid)).data.get('hotel', 'main') == 'chain'; }
    function chainGrantOk(n) {
      return n.apps is map
        && n.apps.keys().hasOnly(['shifts', 'events', 'perms', 'ceo', 'dept', 'mkt', 'exp', 'gm', 'brief', 'front', 'maint', 'fin', 'hk', 'hr', 'spa', 'grp', 'cmp', 'vch', 'vchr', 'hkchk', 'rates'])
        && n.get('hotels', []) is list && n.get('hotels', []).size() == 0
        && n.get('depts', []) is list
        && (isOwner() || roleApp('shifts') || n.get('depts', []).hasOnly(roleDepts()))
        && appsWithin(n.apps) && expGrantOk(n);
    }
    function targetInScope(uid) {
      return allHotels() || (
        exists(/databases/$(database)/documents/employees/$(uid))
        && get(/databases/$(database)/documents/employees/$(uid)).data.get('hotel', 'main') in roleHotels()
      );
    }

    match /roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || canPerms() || (hasRole() && roleApp('hr')));
      allow list: if canPerms() || (hasRole() && roleApp('hr'));
      // מי שמנהל עובדים משייך תפקיד (רק הרשאות שיש לו בעצמו, באותם כללים)
      allow create, update: if request.auth.uid != uid && hasRole() && roleApp('hr') && grantOk(request.resource.data) && (resource == null || existingOk(resource.data)) && targetInScope(uid) && !request.resource.data.get('station', false);
      allow delete: if request.auth.uid != uid && hasRole() && roleApp('hr') && existingOk(resource.data) && targetInScope(uid) && !resource.data.get('station', false);
      allow create, update: if request.auth.uid != uid && hasRole() && roleApp('hr') && chainTarget(uid) && chainGrantOk(request.resource.data) && (resource == null || appsWithin(resource.data.get('apps', {'shifts': true}))) && !request.resource.data.get('station', false);
      allow delete: if request.auth.uid != uid && hasRole() && roleApp('hr') && chainTarget(uid) && appsWithin(resource.data.get('apps', {'shifts': true})) && !resource.data.get('station', false);
      allow create: if isOwner() || (request.auth.uid != uid && canPerms() && grantOk(request.resource.data)
        && (targetInScope(uid) || stationOk(request.resource.data)));
      allow update: if isOwner() || (request.auth.uid != uid && canPerms() && grantOk(request.resource.data) && existingOk(resource.data)
        && (targetInScope(uid) || (stationOk(resource.data) && stationOk(request.resource.data))));
      allow delete: if isOwner() || (request.auth.uid != uid && canPerms() && existingOk(resource.data) && (targetInScope(uid) || stationOk(resource.data)));
    }

    // ---------- סידור עבודה ----------
    // קודי הצטרפות: עובד יכול לבדוק קוד שהוא יודע, רק מנהל המלון יוצר ומחליף
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if shiftsAllHotels();
      allow create: if (manages(request.resource.data.hotel) || hrIn(request.resource.data.hotel)) && (request.resource.data.hotel != 'chain' || allHotels());
      allow update: if ((manages(resource.data.hotel) && manages(request.resource.data.hotel)) || (hrIn(resource.data.hotel) && hrIn(request.resource.data.hotel))) && (request.resource.data.hotel != 'chain' || allHotels());
      allow delete: if manages(resource.data.hotel) || hrIn(resource.data.hotel);
    }
    // תפקידים: תבניות הרשאות (שם + אפליקציות); אצל כל אדם roles/{uid}.job מצביע על התפקיד
    match /jobRoles/{id} {
      allow read: if canPerms() || isOwner() || (hasRole() && roleApp('hr'));
      allow create, update: if isOwner() || (canPerms() && request.resource.data.apps is map && appsWithin(request.resource.data.apps));
      allow delete: if isOwner() || canPerms();
    }

    match /employees/{uid} {
      // עובד רואה רק את הצוות של המלון שלו; מי שיש לו הרשאה רואה רק את המלונות שבהרשאה
      allow get: if signedIn() && (request.auth.uid == uid || seesHotel(hotelOf(resource.data))
        || (isEmployee() && hotelOf(resource.data) == myHotel()) || canCeo());
      allow list: if seesHotel(resource.data.hotel) || (isEmployee() && resource.data.hotel == myHotel()) || canCeo();
      // הרשמה עצמית רק עם קוד הצטרפות תקף, למלון של הקוד
      // עובד נרשם בעצמו בלי מחלקה; את המחלקה קובע מי שיש לו הרשאת עובדים
      allow create: if (hrIn(hotelOf(request.resource.data)) && (hotelOf(request.resource.data) != 'chain' || allHotels())) || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.get('depts', []).size() == 0
        && !('ai' in request.resource.data)
        && request.resource.data.joinCode is string
        && exists(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode))
        && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode)).data.hotel == request.resource.data.hotel
      );
      // עובד מעדכן רק שם, טלפון, תפקיד, משמרות רצויות ומחלקות
      allow update: if (hrIn(hotelOf(resource.data)) && hrIn(hotelOf(request.resource.data))
            && (hotelOf(resource.data) == hotelOf(request.resource.data) || (hotelOf(resource.data) != 'chain' && hotelOf(request.resource.data) != 'chain') || allHotels()))
        // מסך ההרשאות: העברת מלון / תפקיד ניהולי בלבד (רק למלון שבהרשאה; לרשת רק בהרשאה לכל המלונות)
        || ((manages(hotelOf(resource.data)) || (canPerms() && seesHotel(hotelOf(resource.data))))
            && (manages(hotelOf(request.resource.data)) || (canPerms() && seesHotel(hotelOf(request.resource.data))))
            && (hotelOf(resource.data) == hotelOf(request.resource.data) || (hotelOf(resource.data) != 'chain' && hotelOf(request.resource.data) != 'chain') || allHotels())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hotel', 'mgmt']))
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'title', 'want']));
      allow delete: if hrIn(hotelOf(resource.data));
    }

    match /avail/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || hotelStaff(hotelOf(resource.data)) || gmIn(hotelOf(resource.data)) || hrIn(hotelOf(resource.data))
        || (hotelOf(resource.data) == 'chain' && shiftsRole()));
      allow list: if shiftsAllHotels() || (shiftsRole() && (resource.data.hotel in roleHotels() || resource.data.hotel == 'chain'))
        || (hasRole() && roleApp('hr') && (roleHotels().size() == 0 || resource.data.hotel in roleHotels()))
        || (gmRole() && (roleHotels().size() == 0 || resource.data.hotel in roleHotels()));
      allow create: if (signedIn() && request.auth.uid == uid && isEmployee() && request.resource.data.hotel == myHotel())
        || manages(hotelOf(request.resource.data)) || hrIn(hotelOf(request.resource.data)) || (uid.matches('m_.*') && deptMgr(hotelOf(request.resource.data)));
      allow update: if (signedIn() && request.auth.uid == uid && isEmployee() && request.resource.data.hotel == myHotel())
        || (manages(hotelOf(resource.data)) && manages(hotelOf(request.resource.data)))
        || (hrIn(hotelOf(resource.data)) && hrIn(hotelOf(request.resource.data)))
        || (uid.matches('m_.*') && deptMgr(hotelOf(resource.data)) && deptMgr(hotelOf(request.resource.data)));
      allow delete: if (signedIn() && request.auth.uid == uid) || manages(hotelOf(resource.data)) || hrIn(hotelOf(resource.data))
        || (uid.matches('m_.*') && (deptMgr(hotelOf(resource.data)) || gmIn(hotelOf(resource.data))));
    }

    // שכר: רק מנהלי סידור (של המלונות שלהם) ומבט מנכ״ל (קריאה בלבד). מנהל מחלקה לא רואה שכר.
    match /mgr/{uid} {
      allow get: if manages(hotelOf(resource.data)) || canCeo() || gmIn(hotelOf(resource.data)) || hrIn(hotelOf(resource.data));
      allow list: if shiftsAllHotels() || canCeo() || (canShifts() && resource.data.hotel in roleHotels())
        || (gmRole() && (roleHotels().size() == 0 || resource.data.hotel in roleHotels()))
        || (hasRole() && roleApp('hr') && (roleHotels().size() == 0 || resource.data.hotel in roleHotels()));
      allow create: if hrIn(hotelOf(request.resource.data));
      allow update: if (hrIn(hotelOf(resource.data)) && hrIn(hotelOf(request.resource.data)))
        || (manages(hotelOf(resource.data)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hotel']));
      allow delete: if hrIn(hotelOf(resource.data));
    }

    match /settings/{h} {
      allow read: if seesHotel(h) || canCeo() || (isEmployee() && h == myHotel());
      // event places (venues/spaces) decide whose leads and quotes a hotel's people see, so only the owner changes them (Nov 1 security check)
      allow create: if isOwner() || (manages(h) && !('venues' in request.resource.data) && !('spaces' in request.resource.data));
      allow update: if isOwner() || (manages(h) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['venues', 'spaces']));
      allow delete: if isOwner();
      // מי שמנהל עובדים יוצר/מחליף את קוד ההצטרפות בלבד
      allow create: if hrIn(h) && request.resource.data.keys().hasOnly(['joinCode']);
      allow update: if hrIn(h) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinCode']);
    }

    match /hotels/{h} {
      allow read: if isMember();
      allow create, update: if manages(h);
      allow delete: if isOwner();
    }

    match /shifts/{id} {
      allow read: if isMember();
      allow create: if deptManages(hotelOf(request.resource.data), request.resource.data.dept);
      allow update: if deptManages(hotelOf(resource.data), resource.data.dept)
        && deptManages(hotelOf(request.resource.data), request.resource.data.dept);
      allow delete: if deptManages(hotelOf(resource.data), resource.data.dept);
    }
    match /schedule/{id} {
      allow read: if seesHotel(schedHotel(id)) || canCeo() || (isEmployee() && myHotel() == schedHotel(id));
      // מנהל מחלקה משבץ, אבל לא מפרסם ולא מבטל פרסום
      allow write: if manages(schedHotel(id)) || (deptMgr(schedHotel(id))
        && request.resource.data.get('published', false) == (resource == null ? false : resource.data.get('published', false)))
        // קבלה ומנהל מלון: רק נתוני 10days
        || ((frontIn(schedHotel(id)) || gmIn(schedHotel(id))) && (resource == null
              ? request.resource.data.get('assign', {}).size() == 0 && request.resource.data.get('published', false) == false
              : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['daily', 'updatedAt'])));
    }

    // בקשות שינוי אחרי פרסום: המנהל שולח, העובד מאשר או דוחה. בקשה מאושרת נכנסת לסידור.
    match /requests/{id} {
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.get('peer', '') == request.auth.uid
        || hotelStaff(resource.data.hotel) || gmIn(resource.data.hotel)
        || (frontIn(resource.data.hotel) && resource.data.status == 'approved')
        || (isEmployee() && resource.data.hotel == myHotel() && resource.data.status == 'approved'));
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.get('peer', '') == request.auth.uid || shiftsAllHotels()
        || ((canShifts() || (hasRole() && roleApp('dept'))) && resource.data.hotel in roleHotels())
        || (gmRole() && (roleHotels().size() == 0 || resource.data.hotel in roleHotels()))
        || (frontIn(resource.data.hotel) && resource.data.status == 'approved')
        || (isEmployee() && resource.data.hotel == myHotel() && resource.data.status == 'approved')
        || (canCeo() && resource.data.status == 'approved'));
      // עובד מבקש להתחלף עם עובד אחר באותו מלון: העובד השני מסכים, ואז המנהל מאשר
      allow create: if isOwner() || (hotelStaff(request.resource.data.hotel) && request.resource.data.status == 'pending')
        || (isEmployee() && request.resource.data.type == 'swap' && request.resource.data.uid == request.auth.uid
            && request.resource.data.by == request.auth.uid && request.resource.data.hotel == myHotel()
            && request.resource.data.status == 'peer' && request.resource.data.peer is string && request.resource.data.peer != request.auth.uid);
      allow update: if (hotelStaff(resource.data.hotel) && hotelStaff(request.resource.data.hotel))
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending'
            && request.resource.data.status in ['approved', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'reply']))
        || (signedIn() && resource.data.get('type', '') == 'swap' && resource.data.get('peer', '') == request.auth.uid
            && resource.data.status == 'peer' && request.resource.data.status in ['mgr', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'reply']))
        || (signedIn() && resource.data.get('type', '') == 'swap' && resource.data.uid == request.auth.uid
            && resource.data.status in ['peer', 'mgr'] && request.resource.data.status == 'canceled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']));
      allow delete: if manages(resource.data.hotel);
    }

    // ---------- הצעות מחיר לאירועים ----------
    // מבט מנכ״ל קורא הצעות והגדרות, בלי לשנות
    match /config/{id}    { allow read: if canEvents() || canCeo(); allow write: if canEvents(); }
    match /menus/{id}     { allow read, write: if canEvents(); }
    match /contracts/{id} { allow read, write: if canEvents(); }
    match /quotes/{id} {
      // מנהל מלון, בריף וקבלה: רק אירועים במקומות של המלונות שלהם
      // events holders too: only quotes in their hotels' venues (owner / chain-wide roles / ceo = all) — Nov 1, owner
      allow read: if canCeo() || (canEvents() && qVenueOk(resource.data.get('event', {}).get('venue', '')))
        || ((gmRole() || briefRole() || (hasRole() && roleApp('front'))) && (roleHotels().size() == 0 || hotelVenueOk(resource.data.event.venue)));
      allow create: if canEvents() && qVenueOk(request.resource.data.get('event', {}).get('venue', ''));
      allow update: if canEvents() && qVenueOk(resource.data.get('event', {}).get('venue', '')) && qVenueOk(request.resource.data.get('event', {}).get('venue', ''));
      allow delete: if canEvents() && qVenueOk(resource.data.get('event', {}).get('venue', ''));
      // the groups page puts a group's halls on the events board as hotel groups (ids grp_<groupId>_<n>)
      allow create, update: if canGrp() && id.matches('grp_.*') && request.resource.data.kind == 'group';
      allow delete: if canGrp() && id.matches('grp_.*') && resource.data.kind == 'group';
      match /versions/{v} { allow read, write: if canEvents() && qVenueOk(get(/databases/$(database)/documents/quotes/$(id)).data.get('event', {}).get('venue', '')); }
    }

    // ---------- לידים ומכירות (CRM לאירועים) ----------
    // אנשי האירועים מנהלים; סושיאל מדיה קורא, כדי לראות כמה לידים ואירועים הביא כל קמפיין
    // לידים לפי מלון: הרשאה עם מלונות רואה רק לידים של המקומות של המלונות שלה (settings.venues) ולידים בלי מקום
    function qVenueOk(v) { return isOwner() || hotelVenueOk(v); }
    // shared quote number counter (a hotel-scoped user can't see other hotels' quote numbers)
    match /qcounter/{id} { allow read, write: if canEvents(); }
    // a lead with no venue: only owner + chain (all-hotel) roles until someone sets its place (owner, Nov 3)
    function leadVenueOk(v) { return isOwner() || (v == '' ? roleHotels().size() == 0 : hotelVenueOk(v)); }
    match /leads/{id} {
      allow read: if (canEvents() || canMkt()) && leadVenueOk(resource.data.get('venue', ''));
      allow create: if canEvents() && leadVenueOk(request.resource.data.get('venue', ''));
      allow update: if canEvents() && leadVenueOk(resource.data.get('venue', '')) && leadVenueOk(request.resource.data.get('venue', ''));
      allow delete: if canEvents() && leadVenueOk(resource.data.get('venue', ''));
    }
    // משימות ותזכורות של צוות המכירות, והערות לכל לקוח
    // site tours (Nov 4): events users schedule them from a lead; the hotel's brief / manager / reception read them by hotel
    match /tours/{id} {
      allow read: if (canEvents() && leadVenueOk(resource.data.venue)) || briefIn(resource.data.hotel) || frontIn(resource.data.hotel) || gmIn(resource.data.hotel) || manages(resource.data.hotel);
      allow create: if canEvents() && request.resource.data.by == request.auth.uid && request.resource.data.venue is string && request.resource.data.venue != '' && leadVenueOk(request.resource.data.venue)
        && request.resource.data.status == 'scheduled' && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow update: if canEvents() && leadVenueOk(resource.data.venue) && request.resource.data.venue == resource.data.venue && request.resource.data.hotel == resource.data.hotel;
      allow delete: if canEvents() && leadVenueOk(resource.data.venue);
    }
    // hotel separation (Nov 5): a task is seen by its hotel (venue of its lead), its owner and its creator; no-venue tasks only by those two + chain roles
    function taskOk(d) { return leadVenueOk(d.get('venue', '')) || d.get('owner', '') == request.auth.uid || d.get('createdBy', '') == request.auth.uid; }
    match /tasks/{id} {
      allow read, delete: if canEvents() && taskOk(resource.data);
      allow create: if canEvents() && request.resource.data.get('createdBy', '') == request.auth.uid && (request.resource.data.get('venue', '') == '' || leadVenueOk(request.resource.data.venue));
      allow update: if canEvents() && taskOk(resource.data) && request.resource.data.get('venue', '') == resource.data.get('venue', '');
    }
    // WhatsApp (Oct 26): conversations for events users; the server (admin) writes incoming messages and statuses
    // chat ownership (Nov 8): agent = the employee who wrote to the customer first (set by the server); others see the chat only while
    // agent is ''. The owner sees every chat and may transfer it; the agent may release it (agent → '').
    function waSee(c) { return c.get('agent', '') == '' || c.get('agent', '') == request.auth.uid || isOwner(); }
    function waChatOk(id) { let c = get(/databases/$(database)/documents/waChats/$(id)).data; return leadVenueOk(c.get('venue', '')) && waSee(c); }
    // pictures sent from a WhatsApp chat (Nov 13): the sender writes the compressed image, onWaOut uploads it to WhatsApp
    match /waMedia/{m} {
      allow read: if canEvents() && waChatOk(resource.data.chat);
      allow create: if canEvents() && request.resource.data.by == request.auth.uid && request.resource.data.chat is string
        && request.resource.data.keys().hasOnly(['data', 'by', 'chat', 'at', 'mime'])
        && request.resource.data.data is string && request.resource.data.data.size() < 900000
        && request.resource.data.data.matches('^data:image/(jpeg|png);base64,[A-Za-z0-9+/=]+$')
        && (!exists(/databases/$(database)/documents/waChats/$(request.resource.data.chat)) || waChatOk(request.resource.data.chat));
    }
    match /waChats/{id} {
      // hotel separation (Nov 5): venue = the linked lead's venue (kept by the server, waChatVenue); '' = chain roles only
      allow read: if canEvents() && leadVenueOk(resource.data.get('venue', '')) && waSee(resource.data);
      allow create: if canEvents() && request.resource.data.keys().hasOnly(['waId', 'phone', 'name', 'leadId', 'createdAt', 'createdBy', 'unread', 'cat', 'venue', 'agent']) && request.resource.data.get('agent', '') == '' && leadVenueOk(request.resource.data.get('venue', ''));
      allow update: if canEvents() && leadVenueOk(resource.data.get('venue', '')) && waSee(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread', 'readAt', 'readBy', 'leadId', 'name', 'status', 'doneAt', 'doneBy', 'cat', 'agent', 'agentName', 'agentAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['agent', 'agentName', 'agentAt']) || isOwner()
            || (resource.data.get('agent', '') == request.auth.uid && request.resource.data.get('agent', '') == ''));
      match /msgs/{m} {
        allow read: if canEvents() && waChatOk(id);
        // a message to a number with no chat yet is allowed (the server opens the chat)
        allow create: if canEvents() && request.resource.data.dir == 'out' && request.resource.data.status == 'queued' && request.resource.data.by == request.auth.uid
          && (!exists(/databases/$(database)/documents/waChats/$(id)) || waChatOk(id));
      }
    }
    match /wacfg/{id} {
      allow read, write: if isOwner();
    }
    match /broadcasts/{id} {
      // a hotel manager sends to their own hotel's staff (the server drops anyone else); the CEO may send to the whole chain (hotel 'chain')
      allow read: if request.auth != null && (request.auth.uid in resource.data.to || gmIn(resource.data.hotel) || manages(resource.data.hotel) || canCeo()
        || (resource.data.get('kind', '') == 'hkupd' && frontIn(resource.data.hotel)));
      // reception: only the fixed "update the room statuses" request to housekeeping (kind hkupd)
      allow create: if request.resource.data.by == request.auth.uid && request.resource.data.to.size() <= 500
        && (request.resource.data.hotel == 'chain' ? canCeo() : (gmIn(request.resource.data.hotel) || manages(request.resource.data.hotel) || canCeo()
          || (request.resource.data.get('kind', '') == 'hkupd' && frontIn(request.resource.data.hotel))));
      allow update: if request.auth != null && request.auth.uid in resource.data.to && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads']);
    }
    match /leadcats/{id} {
      allow read: if canEvents() || canMkt();
      allow write: if canEvents();
    }
    match /waauto/{id} {
      allow read: if canEvents();
      allow write: if isOwner();
    }
    match /wapub/{id} {
      allow read: if canEvents();
      allow write: if isOwner();
    }
    match /clients/{id} {
      allow read, delete: if canEvents() && leadVenueOk(resource.data.get('venue', ''));
      allow create: if canEvents() && leadVenueOk(request.resource.data.get('venue', ''));
      allow update: if canEvents() && leadVenueOk(resource.data.get('venue', '')) && leadVenueOk(request.resource.data.get('venue', ''));
    }

    // ---------- שיווק ----------
    // social media spend per hotel (Nov 7): the CEO reads all reports, a hotel manager those of their hotel (hotelAuto, set by the server)
    match /campaigns/{id} {
      allow read: if canMkt() || canCeo() || (resource.data.get('hotelAuto', '') != '' && gmIn(resource.data.hotelAuto));
      allow write: if canMkt();
    }
    match /mktcfg/{id} { allow read, write: if canMkt(); }
    // ---------- paid-advertising agent (Nov 7, owner) ----------
    // adReports: written only by the server (admin). A hotel report (hotel = 'h1') is read by that hotel's manager, or by marketing
    // holders of that hotel; a chain report (hotel = '') by the owner, the CEO and marketing holders who see every hotel.
    // UI queries must filter: where('hotel', '==', h)
    match /adReports/{id} {
      allow read: if isOwner() || canCeo()
        || (resource.data.hotel != '' && (gmIn(resource.data.hotel) || (canMkt() && (roleHotels().size() == 0 || resource.data.hotel in roleHotels()))))
        || (resource.data.hotel == '' && canMkt() && roleHotels().size() == 0);
      allow write: if false;
    }
    // yield agent "Guy" reports (Nov 12): server-only writes; hotel report → that hotel's manager; chain report ('') → owner / CEO
    match /yieldReports/{id} {
      allow read: if isOwner() || canCeo() || (resource.data.hotel != '' && gmIn(resource.data.hotel));
      allow write: if false;
    }
    // managers' directions for the ads agent (Nov 7): same readers as adReports; writers = the same people, own text only; author or owner deletes
    match /adNotes/{id} {
      allow read: if isOwner() || canCeo()
        || (resource.data.hotel != '' && (gmIn(resource.data.hotel) || (canMkt() && (roleHotels().size() == 0 || resource.data.hotel in roleHotels()))))
        || (resource.data.hotel == '' && canMkt() && roleHotels().size() == 0);
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['hotel', 'text', 'by', 'byName', 'at'])
        && request.resource.data.hotel is string && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 400
        && (isOwner() || canCeo()
          || (request.resource.data.hotel != '' && (gmIn(request.resource.data.hotel) || (canMkt() && (roleHotels().size() == 0 || request.resource.data.hotel in roleHotels()))))
          || (request.resource.data.hotel == '' && canMkt() && roleHotels().size() == 0));
      allow delete: if isOwner() || (signedIn() && resource.data.by == request.auth.uid);
    }
    // the agent's switch (agentcfg/ads {enabled}) and its business context (agentKB/ads {text}): owner only; its run log: owner reads, server writes
    match /agentcfg/{id} { allow read, write: if isOwner(); }
    match /agentKB/{id}  { allow read, write: if isOwner(); }
    match /agentLog/{id} { allow read: if isOwner(); allow write: if false; }

    // ---------- הוצאות ----------
    // ספקים: הוצאות כותבים; מנהל מלון ומנהל סידור רואים, כדי לשייך פריטי מלאי לספק ולשלוח הזמנות
    match /suppliers/{id}   { allow read: if canExp() || gmRole() || canShifts(); allow write: if canExp(); }
    // fixed expenses (Nov 7): rent, municipal tax… per hotel; expenses holders of the hotel write, CEO and the hotel manager read
    match /fixedExp/{id} {
      allow read: if canCeo() || expIn(resource.data.hotel) || gmIn(resource.data.hotel);
      allow create, update: if expIn(request.resource.data.hotel) && request.resource.data.amount is number && request.resource.data.amount >= 0
        && (resource == null || expIn(resource.data.hotel));
      allow delete: if expIn(resource.data.hotel);
    }
    match /invoices/{id} {
      allow read: if canCeo() || expAll() || (canExp() && resource.data.hotel in expHotelsR())
        || (gmRole() && (roleHotels().size() == 0 || resource.data.hotel in roleHotels()));
      // חשבונית ששולמה מהקופה, מדוח סוף משמרת: הקבלה/מנהלי המלון פותחים אותה כ"פתוחה" וההוצאות מאשרים
      allow create: if expIn(hotelOf(request.resource.data))
        || (request.resource.data.get('source', '') == 'sr' && request.resource.data.status == 'open' && request.resource.data.createdBy == request.auth.uid
            && (frontIn(hotelOf(request.resource.data)) || manages(hotelOf(request.resource.data)) || gmIn(hotelOf(request.resource.data))));
      allow update: if expIn(hotelOf(resource.data)) && expIn(hotelOf(request.resource.data));
      allow delete: if expIn(hotelOf(resource.data));
    }
    match /invoiceImgs/{id} {
      allow read, delete: if expIn(hotelOf(resource.data));
      allow create, update: if expIn(hotelOf(request.resource.data));
      allow create: if !exists(/databases/$(database)/documents/invoiceImgs/$(id))
        && (frontIn(hotelOf(request.resource.data)) || manages(hotelOf(request.resource.data)) || gmIn(hotelOf(request.resource.data)));
    }
    // מייל הנהלת חשבונות לכל מלון: expcfg/{hotel} (main הישן: רק מי שרואה את כל המלונות)
    match /expcfg/{h} { allow read: if canExp(); allow write: if expIn(h) && (h != 'main' || expAll()); }

    // ---------- מלאי ודרישות רכש ----------
    match /inventory/{id} {
      allow read, delete: if stockIn(resource.data.hotel, resource.data.dept);
      allow create: if stockIn(request.resource.data.hotel, request.resource.data.dept);
      allow update: if stockIn(resource.data.hotel, resource.data.dept) && stockIn(request.resource.data.hotel, request.resource.data.dept);
    }
    // אישור קבלת סחורה עם חתימה (מי שמנהל את המלאי של המחלקה); הוצאות ומנכ״ל רואים
    // קישור חתימה ללקוח: המזהה סודי (s + 32 תווים); הלקוח בלי התחברות רק חותם פעם אחת לפני שפג התוקף
    match /signs/{id} {
      allow get: if true;
      allow list: if isOwner();
      allow delete: if canEvents() && qVenueOk(resource.data.get('venue', ''));
      allow create: if canEvents() && request.resource.data.status == 'pending' && qVenueOk(request.resource.data.get('venue', ''));
      allow update: if (canEvents() && resource.data.status == 'pending' && request.resource.data.status == 'pending' && qVenueOk(request.resource.data.get('venue', '')))
        || (resource.data.status == 'pending' && request.resource.data.status == 'signed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'signName', 'sig', 'signedAt', 'agree', 'ua'])
            && request.resource.data.agree == true
            && request.resource.data.signName is string && request.resource.data.signName.size() >= 2 && request.resource.data.signName.size() <= 90
            && request.resource.data.sig is string && request.resource.data.sig.size() < 400000 && request.resource.data.sig.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')
            && (resource.data.get('expMs', 0) == 0 || request.time.toMillis() <= resource.data.expMs));
    }
    match /receipts/{id} {
      allow read: if stockIn(resource.data.hotel, resource.data.dept) || canCeo() || expAll() || (canExp() && resource.data.hotel in expHotelsR());
      allow create: if request.resource.data.by == request.auth.uid && stockIn(request.resource.data.hotel, request.resource.data.dept);
      allow delete: if isOwner();
    }
    // סריקת חשבונית: הצילום נשלח לקריאה אוטומטית (הפונקציה בשרת עונה), רק השולח רואה ומוחק
    match /invoiceScans/{id} {
      allow create: if canExp() && request.resource.data.by == request.auth.uid && request.resource.data.status == 'pending';
      allow read, delete: if signedIn() && resource.data.by == request.auth.uid;
    }
    match /purchaseReqs/{id} {
      allow read: if stockIn(resource.data.hotel, resource.data.dept);
      allow create: if isOwner() || (stockIn(request.resource.data.hotel, request.resource.data.dept)
        && request.resource.data.status == 'pending' && request.resource.data.by == request.auth.uid);
      // מנהל המלון / הסידור מאשר; מנהל המחלקה רק מבטל או מסמן שהתקבל
      allow update: if manages(resource.data.hotel) || gmIn(resource.data.hotel)
        || (stockIn(resource.data.hotel, resource.data.dept) && request.resource.data.status in ['received', 'canceled']
            && request.resource.data.hotel == resource.data.hotel && request.resource.data.dept == resource.data.dept);
      allow delete: if manages(resource.data.hotel) || gmIn(resource.data.hotel);
    }

    // ---------- דוח סיכום משמרת בקבלה ----------
    // הקבלה רק ממלאת ושולחת (לא רואה דוחות וסכומים); מנהל המלון ומנהל הסידור רואים, מתקנים ומוחקים; מנכ״ל רואה (הכנסות קבלה)
    match /shiftReports/{id} {
      allow read: if manages(resource.data.hotel) || gmIn(resource.data.hotel) || canCeo() || finIn(resource.data.hotel);
      allow create: if isOwner() || ((frontIn(request.resource.data.hotel) || manages(request.resource.data.hotel) || gmIn(request.resource.data.hotel))
        && request.resource.data.by == request.auth.uid);
      // כספים: רק סימון אישור ההפקדה
      allow update: if manages(resource.data.hotel) || gmIn(resource.data.hotel)
        || (finIn(resource.data.hotel) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finStatus', 'finNote', 'finBy', 'finAt']));
      // a wrong report may be deleted only within 24 h of being filed (owner, Nov 7); the owner always
      allow delete: if isOwner() || ((manages(resource.data.hotel) || gmIn(resource.data.hotel) || finIn(resource.data.hotel))
        && resource.data.createdAt is number && request.time.toMillis() - resource.data.createdAt < 86400000);
    }

    // דוחות משמרת בלי סכומים (עותק שהשרת כותב): הקבלה רואה את הדוחות של המלון שלה לצורך חפיפה
    // shift report photo of the reception / bar (srImgs/{reportId}); new doc only, no money in it
    // bar (Nov 4): bartenders (bar department of the hotel) file end-of-shift reports; bosses = managers / gm / bar dept managers
    function barMember(h) {
      let p = /databases/$(database)/documents/employees/$(request.auth.uid);
      return signedIn() && exists(p) && get(p).data.get('hotel', '') == h && 'bar' in get(p).data.get('depts', []);
    }
    function barBoss(h) { return manages(h) || gmIn(h) || (deptMgr(h) && 'bar' in roleDepts()); }
    match /barReports/{id} {
      allow read: if signedIn() && (resource.data.by == request.auth.uid || barBoss(resource.data.hotel) || canCeo() || finIn(resource.data.hotel));
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && (barMember(request.resource.data.hotel) || barBoss(request.resource.data.hotel));
      allow update, delete: if barBoss(resource.data.hotel);
    }
    match /barImgs/{id} {
      allow read: if signedIn() && (resource.data.by == request.auth.uid || barBoss(resource.data.hotel) || canCeo() || finIn(resource.data.hotel));
      allow create: if !exists(/databases/$(database)/documents/barImgs/$(id)) && signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.data is string && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
        && (barMember(request.resource.data.hotel) || barBoss(request.resource.data.hotel));
      allow delete: if barBoss(resource.data.hotel);
    }
    match /srImgs/{id} {
      allow read: if frontIn(resource.data.hotel) || manages(resource.data.hotel) || gmIn(resource.data.hotel) || canCeo() || finIn(resource.data.hotel) || cmpIn(resource.data.hotel) || briefIn(resource.data.hotel);
      allow create: if !exists(/databases/$(database)/documents/srImgs/$(id)) && request.resource.data.by == request.auth.uid
        && (frontIn(request.resource.data.hotel) || manages(request.resource.data.hotel) || gmIn(request.resource.data.hotel));
      allow delete: if manages(resource.data.hotel) || gmIn(resource.data.hotel);
    }
    match /shiftReportsPub/{id} {
      allow read: if frontIn(resource.data.hotel) || manages(resource.data.hotel) || gmIn(resource.data.hotel) || canCeo() || finIn(resource.data.hotel) || cmpIn(resource.data.hotel) || briefIn(resource.data.hotel);
      allow write: if isOwner();
    }

    // ---------- משק: לוח החדרים ----------
    // hk/{hotel}__{date}: הקבלה, מנהל המלון ומנהלי הסידור מעדכנים הכול; עובדי משק רק את מצב הניקיון
    function hkFullIn(h) { return manages(h) || gmIn(h) || frontIn(h); }
    function hkWorkIn(h) {
      return hkFullIn(h)
        || (hasRole() && (roleApp('hk') || roleApp('hkchk')) && (roleHotels().size() == 0 || h in roleHotels()))
        || (deptMgr(h) && 'housekeeping' in roleDepts())
        || (isEmployee() && myHotel() == h
            && 'housekeeping' in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('depts', []));
    }
    // מנהל מחלקת משק: גם משבץ חדרים לעובדים
    function hkLeadIn(h) { return hkFullIn(h) || (deptMgr(h) && 'housekeeping' in roleDepts()); }
    // קריאות מהקבלה למשק: הקבלה/מנהלים פותחים ורואים; העובד שהקריאה נשלחה אליו רואה אותה ומסמן "טופל"
    match /hkCalls/{id} {
      allow read: if signedIn() && (hkFullIn(resource.data.hotel) || resource.data.to == request.auth.uid);
      allow create: if signedIn() && hkFullIn(request.resource.data.hotel) && request.resource.data.openedBy == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if signedIn() && (hkFullIn(resource.data.hotel)
        || (resource.data.to == request.auth.uid && request.resource.data.status == 'done'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt', 'mins'])));
      allow delete: if signedIn() && hkFullIn(resource.data.hotel);
    }
    // חדרים חסומים בלי תקלה (OOS): id = hotel__room
    // DND door photo (worker must photograph the sign before marking DND)
    match /hkDndImgs/{id} {
      allow read: if signedIn() && (hkFullIn(resource.data.hotel) || hkWorkIn(resource.data.hotel));
      allow create, update: if signedIn() && id == request.resource.data.hotel + '__' + request.resource.data.date + '__' + request.resource.data.room
        && request.resource.data.by == request.auth.uid && request.resource.data.data is string && request.resource.data.data.size() < 900000
        && request.resource.data.data.matches('^data:image/[a-z]+;base64,[A-Za-z0-9+/=]+$')
        && (hkFullIn(request.resource.data.hotel) || hkWorkIn(request.resource.data.hotel));
      allow delete: if signedIn() && hkFullIn(resource.data.hotel);
    }
    match /hkBlocks/{id} {
      allow read: if signedIn() && (hkFullIn(resource.data.hotel) || hkWorkIn(resource.data.hotel) || maintIn(resource.data.hotel) || briefIn(resource.data.hotel));
      allow create, update: if signedIn() && id == request.resource.data.hotel + '__' + request.resource.data.room
        && request.resource.data.by == request.auth.uid && hkFullIn(request.resource.data.hotel);
      allow delete: if signedIn() && hkFullIn(resource.data.hotel);
    }
    match /hkday/{h} {
      allow read: if hkFullIn(h) || hkWorkIn(h) || maintIn(h) || briefIn(h);
      allow write: if hkFullIn(h);
    }
    // hk role checks are computed once (let) — the old chain (hkFullIn/hkLeadIn/hkWorkIn, each calling isOwner/roles again)
    // hit Firestore's 1000-expression limit for workers with a verified e-mail, so their writes were refused (Oct 24)
    function hkWorkKeys() { return ['hotel', 'date', 'carried', 'lastBy', 'clean', 'cleanBy', 'cleanAt', 'start', 'done', 'doneBy', 'note', 'noteBy', 'noteAt', 'chk', 'chkBy', 'chkAt', 'back', 'trtDone', 'trtBy', 'trtByName', 'dnd', 'dndBy', 'updatedAt']; }
    function hkLeadKeys() { return hkWorkKeys().concat(['asg', 'asgName', 'asgAt']); }
    function hkWriteOk(h, ks) {
      let own = isOwner();
      let hr = !own && hasRole();
      let rd = hr ? roleData() : {};
      let apps = rd.get('apps', {'shifts': true});
      let hs = rd.get('hotels', []);
      let inH = hs.size() == 0 || h in hs;
      let full = own || (hr && inH && (apps.get('shifts', false) == true || apps.get('gm', false) == true || apps.get('front', false) == true));
      let lead = hr && apps.get('dept', false) == true && h in hs && 'housekeeping' in rd.get('depts', []);
      return full
        || (ks.hasOnly(hkLeadKeys()) && lead)
        || (ks.hasOnly(hkWorkKeys()) && (lead
            || (hr && inH && (apps.get('hk', false) == true || apps.get('hkchk', false) == true))
            || (isEmployee() && myHotel() == h
                && 'housekeeping' in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('depts', []))));
    }
    match /hk/{id} {
      allow read: if signedIn() && (hkWorkIn(id.split('__')[0]) || maintIn(id.split('__')[0]) || briefIn(id.split('__')[0]));
      allow create: if request.resource.data.hotel == id.split('__')[0] && hkWriteOk(request.resource.data.hotel, request.resource.data.keys());
      allow update: if request.resource.data.hotel == resource.data.hotel && hkWriteOk(resource.data.hotel, request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if manages(resource.data.hotel) || gmIn(resource.data.hotel);
    }
    // זמני ניקיון (התחלה–סיום) לכל חדר: העובד כותב את שלו, רק מנהלים קוראים (ממוצע לעובד)
    match /hkLog/{id} {
      allow read: if manages(resource.data.hotel) || gmIn(resource.data.hotel) || canCeo();
      allow create: if isOwner() || (hkWorkIn(request.resource.data.hotel) && request.resource.data.uid == request.auth.uid);
      allow update: if isOwner() || (hkWorkIn(request.resource.data.hotel) && request.resource.data.uid == request.auth.uid && resource.data.uid == request.auth.uid);
      allow delete: if manages(resource.data.hotel) || gmIn(resource.data.hotel);
    }
    // תלונות אורחים על חדר (מדוח סיכום משמרת), נרשמות על המנקה: הקבלה כותבת, רק מנהלים קוראים
    match /hkComplaints/{id} {
      allow read: if manages(resource.data.hotel) || gmIn(resource.data.hotel) || canCeo() || cmpIn(resource.data.hotel) || frontIn(resource.data.hotel) || briefIn(resource.data.hotel);
      allow create: if isOwner() || ((frontIn(request.resource.data.hotel) || manages(request.resource.data.hotel) || gmIn(request.resource.data.hotel))
        && request.resource.data.by == request.auth.uid);
      allow update: if manages(resource.data.hotel) || gmIn(resource.data.hotel)
        || (cmpIn(resource.data.hotel) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledBy', 'handledByName', 'handledAt', 'handleNote', 'voucherId', 'voucherCode']));
      allow delete: if manages(resource.data.hotel) || gmIn(resource.data.hotel);
    }
    // רשימת החדרים של כל מלון
    match /hkcfg/{h} {
      allow read: if signedIn() && (hkWorkIn(h) || maintIn(h) || briefIn(h));
      allow write: if isOwner();
    }

    // ---------- אחזקה: תקלות ----------
    // אחזקה ומנהלים רואים ומעדכנים; הקבלה פותחת תקלות (מדוח משמרת) ורואה אותן; מחיקה רק למנהלים
    match /faultsAck/{id} {
      allow read: if maintIn(resource.data.hotel);
      allow create, update: if maintIn(request.resource.data.hotel);
      allow delete: if maintIn(resource.data.hotel);
    }
    // reception may only ADD one update line of its own; earlier lines stay exactly as they were
    function fltUpdOk() {
      let o = resource.data.get('upd', []);
      let n = request.resource.data.upd;
      return n is list && n.size() == o.size() + 1 && n[0:o.size()] == o
        && n[o.size()].by == request.auth.uid && n[o.size()].text is string && n[o.size()].text.size() <= 500;
    }
    match /faults/{id} {
      allow read: if maintIn(resource.data.hotel) || frontIn(resource.data.hotel) || briefIn(resource.data.hotel);
      allow create: if isOwner() || ((maintIn(request.resource.data.hotel) || frontIn(request.resource.data.hotel)
          || (request.resource.data.get('source', '') == 'hk' && hkWorkIn(request.resource.data.hotel)))
        && request.resource.data.status == 'open' && request.resource.data.openedBy == request.auth.uid);
      allow update: if (maintIn(resource.data.hotel) && maintIn(request.resource.data.hotel))
        || (frontIn(resource.data.hotel) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upd', 'updAt']) && fltUpdOk());
      allow delete: if manages(resource.data.hotel) || gmIn(resource.data.hotel);
    }

    // ---------- התראות לטלפון ----------
    // כל מכשיר שומר את הכתובת שלו לקבלת התראות; רק בעל החשבון (ובעל המערכת) רואה ומשנה. השליחה עצמה מהשרת.
    // daily Drive backup: the secret key the Apps Script sends (only the owner sees it); the function writes lastAt
    // ספא: מי שיש לו הרשאת ספא מזין ורואה; הבריף היומי ומנהל המלון רואים את הטיפולים של המלון שלהם (גוטמן)
    match /spa/{id} {
      allow read: if canSpa() || (hasRole() && (roleApp('brief') || roleApp('gm'))
        && (roleHotels().size() == 0 || resource.data.get('hotel', '') in roleHotels()));
      allow write: if canSpa();
    }
    // therapist shifts per day (online booking checks them on the server)
    match /spaShifts/{id} {
      allow read, write: if canSpa();
    }
    // spa health declaration: guest opens the secret link while pending, signs once; spa staff read/create/delete
    match /spaHealth/{id} {
      allow get: if canSpa() || resource.data.status == 'pending';
      allow list, delete: if canSpa();
      allow create: if canSpa() && request.resource.data.status == 'pending';
      allow update: if (canSpa() && resource.data.status == 'pending' && request.resource.data.status == 'pending')
        || (resource.data.status == 'pending' && request.resource.data.status == 'signed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'signName', 'signPhone', 'idNo', 'answers', 'qs', 'details', 'flag', 'sig', 'signedAt', 'agree', 'ua'])
            && request.resource.data.agree == true && request.resource.data.answers is map
            && request.resource.data.signName is string && request.resource.data.signName.size() >= 2 && request.resource.data.signName.size() <= 90
            && request.resource.data.details is string && request.resource.data.details.size() <= 1500
            && request.resource.data.sig is string && request.resource.data.sig.size() < 400000 && request.resource.data.sig.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')
            && (resource.data.get('expMs', 0) == 0 || request.time.toMillis() <= resource.data.expMs));
    }
    match /groups/{id} {
      // gm (their hotels) and CEO read groups for the revenue figures
      allow read: if canGrp() || canCeo() || (gmRole() && (roleHotels().size() == 0 || resource.data.hotel in roleHotels()));
      allow write: if canGrp();
      // group guide page (owner, Nov 5): reception / hotel managers set the group's rooms, guide details, link key and messages
      allow update: if (frontIn(resource.data.hotel) || gmIn(resource.data.hotel) || manages(resource.data.hotel))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guideRooms', 'guideName', 'guidePhone', 'guideKey', 'guideMsgs', 'guideAt', 'guideBy', 'guideWaReq', 'meals', 'roomPax', 'roomCat', 'halls', 'hallsAt', 'hallsBy'])
        && (!('halls' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.halls.size() == resource.data.get('halls', []).size())
        && (!('guideKey' in request.resource.data) || request.resource.data.guideKey.matches('^g[0-9a-f]{32}$'));
    }
    // groups without prices for reception (written only by the server: mirrorGroupPub)
    match /groupsPub/{id} {
      allow read: if canGrp() || canCeo() || (gmRole() && (roleHotels().size() == 0 || resource.data.hotel in roleHotels())) || frontIn(resource.data.hotel);
    }
    match /agents/{id} {
      allow read, write: if canGrp();
    }
    match /priceLists/{id} {
      allow read, write: if canGrp();
    }
    match /spaQuotes/{id} {
      allow read, write: if canSpa();
    }
    match /spacfg/{id} {
      allow read, write: if canSpa();
    }
    match /vouchers/{id} {
      allow get: if true;
      allow list: if canVch();
      allow create: if canVch() && request.resource.data.createdBy == request.auth.uid && request.resource.data.status == 'active';
      // issuers (vch) may cancel; redeemers (vchr) may only record a redemption
      allow update: if (canVch() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'hist', 'updatedAt']) && request.resource.data.status == 'cancelled')
        || (canVchR() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'status', 'hist', 'updatedAt']) && request.resource.data.status in ['partial', 'redeemed'] && request.resource.data.balance is number && request.resource.data.balance >= 0 && request.resource.data.balance <= resource.data.get('balance', 0))
        || isOwner();
      allow delete: if isOwner();
    }
    match /srDrafts/{id} {
      allow read, delete: if signedIn() && (id.split('__')[0] == request.auth.uid || isOwner());
      allow create, update: if signedIn() && id.split('__')[0] == request.auth.uid && request.resource.data.by == request.auth.uid;
    }
    // code → voucher id, so redeem-only users find one voucher by its code without listing all vouchers
    match /vchCodes/{code} {
      allow get: if canVch() || canVchR();
      allow list: if canVch();
      allow create, update: if canVch();
      allow delete: if isOwner();
    }
    match /vchcfg/{id} {
      allow read: if canVch() || canVchR();
      allow write: if canVch();
    }
    match /backupcfg/{id} {
      allow read, write: if isOwner();
    }
    // price comparison (Nov 7): key for the owner's price agent (owner only); results are written by the function ratesIngest (admin)
    // weekly FX rates (Nov 7): written by the server (fxWeekly / fxRunNow); the owner may fix a week by hand (manual: true)
    match /fxRates/{id} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    match /ratescfg/{id} {
      allow read, write: if isOwner();
    }
    match /ratesLog/{id} {
      allow read: if isOwner() || canCeo() || gmIn(resource.data.hotel) || (hasRole() && roleApp('rates') && (roleHotels().size() == 0 || resource.data.hotel in roleHotels()));
      allow write: if false;
    }
    // Meta (Facebook/Instagram) connection: system-user token, owner only; the functions (admin) read it and write status
    // chain settings (name, event venues, spa hotel): every member reads, only the owner writes
    // username → e-mail for username/password sign-in (looked up before signing in)
    match /usernames/{u} {
      // the username → e-mail map is private (Nov 4): sign-in resolves usernames on the server (function pwGuard)
      allow get: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && u.matches('^[a-z0-9._-]{3,30}$')
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // chains/hotels registry (home database only): web config needed to open a chain, readable by anyone who has the id
    match /chains/{id} {
      allow get: if true;
      allow list, write: if isPlatform();
    }
    // shift kinds (names + extra kinds), chain-wide: employees-page (hr) holders and shift managers edit
    match /shiftKinds/{id} {
      allow read: if signedIn();
      allow write: if isOwner() || (hasRole() && (roleApp('hr') || roleApp('shifts')));
    }
    match /orgcfg/{id} {
      allow read: if signedIn();
      // lic = the pages this chain may use; only the owner of the whole system sets it
      allow create: if isPlatform() || (isOwner() && !('lic' in request.resource.data) && !('ownerEmail' in request.resource.data));
      allow update: if isPlatform() || (isOwner() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lic', 'ownerEmail']));
      allow delete: if isPlatform();
    }
    // Google Ads connection (Nov 11): OAuth client + refresh token, owner only; the functions read it and write status
    match /gadscfg/{id} {
      allow read, write: if isOwner();
    }
    match /metacfg/{id} {
      allow read, write: if isOwner();
    }
    // login lockout (written by the pwGuard function only): managers see who is locked to reset them
    match /authLockPub/{uid} {
      allow read: if canPerms() || (hasRole() && roleApp('hr'));
    }
    match /pushTokens/{uid} {
      // owner:true makes the server send the owner's notifications to this device → only the owner may set it
      allow read, delete: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create, update: if signedIn() && (request.auth.uid == uid || isOwner())
        && (request.resource.data.get('owner', false) == false || isOwner());
    }

    // כל השאר חסום
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
